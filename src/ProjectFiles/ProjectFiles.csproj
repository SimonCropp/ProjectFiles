<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);PolyfillTargetsForNuget</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\ProjectFiles.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\ProjectFiles.props" Pack="true" PackagePath="build\" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" Condition="'$(CI)' == 'true'" />
    <EmbeddedResource Include="..\Templates\ProjectDirectory.cs"/>
    <EmbeddedResource Include="..\Templates\ProjectFile.cs"/>
    <EmbeddedResource Include="..\Templates\EmbeddedResource.cs"/>
    <None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
    <None Include="bin\$(Configuration)\net10.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
  </ItemGroup>

</Project>
