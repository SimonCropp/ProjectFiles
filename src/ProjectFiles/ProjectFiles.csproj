<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);PolyfillTargetsForNuget</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\ProjectFiles.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\ProjectFiles.props" Pack="true" PackagePath="build\" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Sbom" PrivateAssets="all" />
    <EmbeddedResource Include="..\Templates\ProjectDirectory.cs"/>
    <EmbeddedResource Include="..\Templates\ProjectFile.cs"/>
    <EmbeddedResource Include="..\Templates\EmbeddedResource.cs"/>
    <!--
      The folder name is the lowest compiler that loads the analyzer. It must match the version of
      Microsoft.CodeAnalysis.CSharp referenced (an older compiler rejects the assembly with CS9057)
      and the Roslyn shipped by MinimumSdkVersion in ProjectFiles.props.
      The netstandard2.0 build is the one shipped: it loads in both .NET and .NET Framework hosted
      compilers (Visual Studio can run generators in a .NET Framework process).
    -->
    <None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
  </ItemGroup>

</Project>
