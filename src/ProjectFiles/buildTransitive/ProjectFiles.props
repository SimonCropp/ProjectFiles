<Project>

  <Target Name="CheckSdkVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <MinimumSdkVersion>10.0.100</MinimumSdkVersion>
    </PropertyGroup>

    <Error
      Condition="$([MSBuild]::VersionLessThan($(NETCoreSdkVersion), $(MinimumSdkVersion)))"
      Text="This project requires .NET SDK $(MinimumSdkVersion) or higher. Current SDK version is $(NETCoreSdkVersion)." />
  </Target>

  <!--
    Writes a manifest describing the project to the intermediate directory and hands that single
    file to the source generator as an AdditionalFiles item. One line per entry:

      Project|<full path of the project file>
      Solution|<full path of the solution file>
      File|<path relative to the output directory>
      Resource|<project relative path>|<manifest resource name>

    A manifest is used, instead of adding every file to AdditionalFiles, for two reasons:

     * AdditionalFiles are inputs of CoreCompile, so adding each copied file would recompile the
       project whenever the content of one of them changes. The manifest only changes (it is
       written with WriteOnlyWhenDifferent) when the set of files changes.
     * Item metadata and properties reach a generator through the generated .editorconfig, where
       a value is cut at the first '#' or ';'. Paths read from the manifest are not affected.

    It depends on PrepareResourceNames (which runs AssignTargetPaths, SplitResourcesByCulture
    and CreateManifestResourceNames in order) so that MSBuild has computed the authoritative
    %(EmbeddedResource.ManifestResourceName) (honouring RootNamespace etc.) before it is captured.
  -->

  <Target Name="AddProjectFilesToAdditionalFiles"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun"
          DependsOnTargets="PrepareResourceNames">
    <PropertyGroup>
      <!--
        The Sdks directory of the .NET SDK in use. Items defined by any SDK in there (the default
        globs of Microsoft.NET.Sdk, and the Content items of the Web and Worker SDKs) belong to the
        project, as opposed to items contributed by a NuGet package.
      -->
      <_ProjectFilesSdksDirectory>$([MSBuild]::NormalizeDirectory('$(MicrosoftNETBuildTasksDirectoryRoot)', '..', '..'))</_ProjectFilesSdksDirectory>
      <_ProjectFilesManifest>$(IntermediateOutputPath)ProjectFiles.manifest.txt</_ProjectFilesManifest>
    </PropertyGroup>
    <!-- Values are escaped so that a ';' in a path does not split the line into two items -->
    <ItemGroup>
      <_ProjectFilesManifestLine Include="Project|$([MSBuild]::Escape('$(MSBuildProjectFullPath)'))" />
      <_ProjectFilesManifestLine Include="Solution|$([MSBuild]::Escape('$(SolutionPath)'))"
                                 Condition="'$(SolutionPath)' != '' AND '$(SolutionPath)' != '*Undefined*'" />
      <!-- None items with CopyToOutputDirectory -->
      <!-- Use %(Link) if available (for linked files from other projects), otherwise use actual path -->
      <_ProjectFilesManifestLine Include="File|$([MSBuild]::Escape($([MSBuild]::ValueOrDefault('%(None.Link)', '%(None.RelativeDir)%(None.Filename)%(None.Extension)'))))"
                                 Condition="
                                   (
                                     '%(None.CopyToOutputDirectory)' == 'PreserveNewest' OR
                                     '%(None.CopyToOutputDirectory)' == 'Always' OR
                                     '%(None.CopyToOutputDirectory)' == 'IfDifferent'
                                   )
                                   AND
                                   (
                                     '%(None.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' OR
                                     $([System.String]::Copy('%(None.DefiningProjectFullPath)').StartsWith('$(_ProjectFilesSdksDirectory)', System.StringComparison.OrdinalIgnoreCase))
                                   )
                                 " />
      <!-- Content items with CopyToOutputDirectory -->
      <_ProjectFilesManifestLine Include="File|$([MSBuild]::Escape($([MSBuild]::ValueOrDefault('%(Content.Link)', '%(Content.RelativeDir)%(Content.Filename)%(Content.Extension)'))))"
                                 Condition="
                                   (
                                     '%(Content.CopyToOutputDirectory)' == 'PreserveNewest' OR
                                     '%(Content.CopyToOutputDirectory)' == 'Always' OR
                                     '%(Content.CopyToOutputDirectory)' == 'IfDifferent'
                                   )
                                   AND
                                   (
                                     '%(Content.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' OR
                                     $([System.String]::Copy('%(Content.DefiningProjectFullPath)').StartsWith('$(_ProjectFilesSdksDirectory)', System.StringComparison.OrdinalIgnoreCase))
                                   )
                                 " />
      <!--
        Embedded resources are always compiled into the assembly being built, so (unlike
        CopyToOutputDirectory items) there is no need to filter by DefiningProjectFullPath.
        That metadata is unusable here anyway: AssignTargetPaths removes and re-includes
        @(EmbeddedResource) inside the SDK targets, so by this point every item's
        DefiningProjectFullPath points at the SDK targets rather than the consuming project.
        %(LogicalName) wins when set, since that is the name the compiler embeds. .resx files
        are excluded because they are consumed via ResourceManager rather than as raw manifest
        streams. Culture specific resources (eg text.fr.txt) are excluded because they are
        compiled into a satellite assembly rather than the main one.
      -->
      <_ProjectFilesManifestLine Include="Resource|$([MSBuild]::Escape($([MSBuild]::ValueOrDefault('%(EmbeddedResource.Link)', '%(EmbeddedResource.RelativeDir)%(EmbeddedResource.Filename)%(EmbeddedResource.Extension)'))))|$([MSBuild]::Escape($([MSBuild]::ValueOrDefault('%(EmbeddedResource.LogicalName)', '%(EmbeddedResource.ManifestResourceName)'))))"
                                 Condition="
                                   '%(EmbeddedResource.ManifestResourceName)' != '' AND
                                   '%(EmbeddedResource.Extension)' != '.resx' AND
                                   '%(EmbeddedResource.WithCulture)' != 'true'
                                 " />
    </ItemGroup>
    <WriteLinesToFile File="$(_ProjectFilesManifest)"
                      Lines="@(_ProjectFilesManifestLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <AdditionalFiles Include="$(_ProjectFilesManifest)" />
      <FileWrites Include="$(_ProjectFilesManifest)" />
    </ItemGroup>
  </Target>

  <!-- Only ImplicitUsings is read as a property. Paths come from the manifest. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ImplicitUsings" />
  </ItemGroup>

</Project>
