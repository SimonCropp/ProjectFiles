<Project>

  <Target Name="CheckSdkVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <MinimumSdkVersion>10.0.100</MinimumSdkVersion>
    </PropertyGroup>

    <Error
      Condition="$([MSBuild]::VersionLessThan($(NETCoreSdkVersion), $(MinimumSdkVersion)))"
      Text="This project requires .NET SDK $(MinimumSdkVersion) or higher. Current SDK version is $(NETCoreSdkVersion)." />
  </Target>

  <!--
    This MSBuild target automatically adds all files with CopyToOutputDirectory
    to AdditionalFiles so the source generator can access them with their metadata.

    MSBuild will automatically evaluate conditions and only include files where
    conditions are true, eliminating the need for manual condition parsing.
  -->

  <Target Name="AddProjectFilesToAdditionalFiles"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
    <ItemGroup>
      <!-- Add None items with CopyToOutputDirectory -->
      <!-- Use %(Link) if available (for linked files from other projects), otherwise use actual path -->
      <AdditionalFiles Include="@(None)"
                       ProjectFilesGenerator="$([MSBuild]::ValueOrDefault('%(None.Link)', '%(RelativeDir)%(Filename)%(Extension)'))"
                       Condition="
                         (
                           '%(None.CopyToOutputDirectory)' == 'PreserveNewest' OR
                           '%(None.CopyToOutputDirectory)' == 'Always'
                         )
                         AND
                         (
                           '%(None.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' OR
                           $([System.String]::Copy('%(None.DefiningProjectFullPath)').EndsWith('Microsoft.NET.Sdk.DefaultItems.props'))
                         )
                       " />
      <!-- Add Content items with CopyToOutputDirectory -->
      <!-- Use %(Link) if available (for linked files from other projects), otherwise use actual path -->
      <AdditionalFiles Include="@(Content)"
                       ProjectFilesGenerator="$([MSBuild]::ValueOrDefault('%(Content.Link)', '%(RelativeDir)%(Filename)%(Extension)'))"
                       Condition="
                         (
                           '%(Content.CopyToOutputDirectory)' == 'PreserveNewest' OR
                           '%(Content.CopyToOutputDirectory)' == 'Always'
                         )
                         AND
                         (
                           '%(Content.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' OR
                           $([System.String]::Copy('%(Content.DefiningProjectFullPath)').EndsWith('Microsoft.NET.Sdk.DefaultItems.props'))
                         )
                       " />
    </ItemGroup>
  </Target>

  <!--
    This MSBuild target automatically adds all EmbeddedResource files to AdditionalFiles
    so the source generator can expose them via a strongly-typed API.

    It depends on PrepareResourceNames (which runs AssignTargetPaths, SplitResourcesByCulture
    and CreateManifestResourceNames in order) so that MSBuild has computed the authoritative
    %(EmbeddedResource.ManifestResourceName) (honouring RootNamespace, LogicalName, etc.)
    before we capture it. .resx files are excluded because they are consumed via
    ResourceManager rather than as raw manifest streams.
  -->

  <Target Name="AddProjectEmbeddedResourcesToAdditionalFiles"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun"
          DependsOnTargets="PrepareResourceNames">
    <ItemGroup>
      <!--
        Embedded resources are always compiled into the assembly being built, so (unlike
        CopyToOutputDirectory items) there is no need to filter by DefiningProjectFullPath.
        That metadata is unusable here anyway: AssignTargetPaths removes and re-includes
        @(EmbeddedResource) inside the SDK targets, so by this point every item's
        DefiningProjectFullPath points at the SDK targets rather than the consuming project.
        Use %(Link) if available (for linked files), otherwise the actual relative path.
      -->
      <AdditionalFiles Include="@(EmbeddedResource)"
                       ProjectFilesEmbeddedResource="$([MSBuild]::ValueOrDefault('%(EmbeddedResource.Link)', '%(RelativeDir)%(Filename)%(Extension)'))"
                       ProjectFilesEmbeddedResourceName="%(EmbeddedResource.ManifestResourceName)"
                       Condition="
                         '%(EmbeddedResource.ManifestResourceName)' != '' AND
                         '%(EmbeddedResource.Extension)' != '.resx'
                       " />
    </ItemGroup>
  </Target>

  <!--
    Make the CopyToOutputDirectory metadata visible to the source generator.
    This allows the generator to verify that files have the correct metadata.
  -->
  <ItemGroup>
    <CompilerVisibleItemMetadata
      Include="AdditionalFiles"
      MetadataName="ProjectFilesGenerator" />
    <CompilerVisibleItemMetadata
      Include="AdditionalFiles"
      MetadataName="ProjectFilesEmbeddedResource" />
    <CompilerVisibleItemMetadata
      Include="AdditionalFiles"
      MetadataName="ProjectFilesEmbeddedResourceName" />
  </ItemGroup>

  <!-- Expose project and solution paths to the source generator -->
  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectFullPath" />
    <CompilerVisibleProperty Include="SolutionPath" />
    <CompilerVisibleProperty Include="ImplicitUsings" />
  </ItemGroup>

</Project>
